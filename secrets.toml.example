# Copie este arquivo para ".streamlit/secrets.toml" (mesmo nome de pasta,
# sem o ".example" no final) e preencha com os dados reais da sua Service
# Account do Google Cloud. NUNCA suba o secrets.toml real para o GitHub.

[connections.gsheets]
spreadsheet = "COLE_AQUI_A_URL_COMPLETA_DA_SUA_PLANILHA"
type = "service_account"
project_id = "seu-project-id"
private_key_id = "sua-private-key-id"
private_key = "-----BEGIN PRIVATE KEY-----\nSUA_CHAVE_AQUI\n-----END PRIVATE KEY-----\n"
client_email = "nome-da-service-account@seu-project-id.iam.gserviceaccount.com"
client_id = "seu-client-id"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "URL_DO_CERTIFICADO_DA_SUA_SERVICE_ACCOUNT"
